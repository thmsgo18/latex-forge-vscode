{
  "name": "latex-forge-vscode",
  "displayName": "LaTeX Forge",
  "description": "Create and manage LaTeX Forge projects without leaving the editor",
  "version": "1.2.0",
  "publisher": "thmsgo18",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thmsgo18/latex-forge-vscode"
  },
  "homepage": "https://github.com/thmsgo18/latex-forge-vscode#readme",
  "bugs": {
    "url": "https://github.com/thmsgo18/latex-forge-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionPack": [
    "James-Yu.latex-workshop"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "latex-forge",
    "pdf",
    "templates"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "latex-forge.createProject",
        "title": "LaTeX Forge: Create Project"
      },
      {
        "command": "latex-forge.renameProject",
        "title": "LaTeX Forge: Rename Project"
      },
      {
        "command": "latex-forge.renameCurrentProject",
        "title": "LaTeX Forge: Rename Current Project"
      },
      {
        "command": "latex-forge.setupEnvironment",
        "title": "LaTeX Forge: Setup Environment"
      },
      {
        "command": "latex-forge.listTemplates",
        "title": "LaTeX Forge: List Templates"
      },
      {
        "command": "latex-forge.installTemplate",
        "title": "LaTeX Forge: Install Template",
        "icon": "$(cloud-download)"
      },
      {
        "command": "latex-forge.browseGallery",
        "title": "LaTeX Forge: Browse Template Gallery",
        "icon": "$(search)"
      },
      {
        "command": "latex-forge.removeTemplate",
        "title": "LaTeX Forge: Remove Template",
        "icon": "$(trash)"
      },
      {
        "command": "latex-forge.refreshTemplates",
        "title": "LaTeX Forge: Refresh Templates",
        "icon": "$(refresh)"
      },
      {
        "command": "latex-forge.editProfile",
        "title": "LaTeX Forge: Edit Profile",
        "icon": "$(account)"
      },
      {
        "command": "latex-forge.configureDefaults",
        "title": "LaTeX Forge: Configure Defaults"
      },
      {
        "command": "latex-forge.checkForUpdate",
        "title": "LaTeX Forge: Check for CLI Update"
      },
      {
        "command": "latex-forge.updateTemplates",
        "title": "LaTeX Forge: Update Templates",
        "icon": "$(arrow-up)"
      },
      {
        "command": "latex-forge.diagnose",
        "title": "LaTeX Forge: Diagnose Environment",
        "icon": "$(beaker)"
      }
    ],
    "walkthroughs": [
      {
        "id": "latexForgeGettingStarted",
        "title": "Get Started with LaTeX Forge",
        "description": "Set up LaTeX Forge and create your first ready-to-write document.",
        "icon": "media/activity-bar-icon.svg",
        "steps": [
          {
            "id": "installCli",
            "title": "Install the LaTeX Forge CLI",
            "description": "Check your machine and install the LaTeX Forge CLI, LaTeX itself, and recommended VS Code extensions.\n[Run Setup](command:latex-forge.setupEnvironment)",
            "media": {
              "markdown": "walkthroughs/install-cli.md"
            },
            "completionEvents": [
              "onCommand:latex-forge.setupEnvironment"
            ]
          },
          {
            "id": "createProject",
            "title": "Create your first project",
            "description": "Generate a complete document project — folder structure, styles, bibliography, and live PDF preview.\n[Create Project](command:latex-forge.createProject)",
            "media": {
              "markdown": "walkthroughs/create-project.md"
            },
            "completionEvents": [
              "onCommand:latex-forge.createProject"
            ]
          },
          {
            "id": "browseGallery",
            "title": "Browse the template gallery",
            "description": "Explore 80+ curated templates with previews — CVs, theses, articles, posters, presentations.\n[Browse Gallery](command:latex-forge.browseGallery)",
            "media": {
              "markdown": "walkthroughs/browse-gallery.md"
            },
            "completionEvents": [
              "onCommand:latex-forge.browseGallery"
            ]
          },
          {
            "id": "editProfile",
            "title": "Set up your profile",
            "description": "Save your name, email, and university once so every new project starts pre-filled.\n[Edit Profile](command:latex-forge.editProfile)",
            "media": {
              "markdown": "walkthroughs/edit-profile.md"
            },
            "completionEvents": [
              "onCommand:latex-forge.editProfile"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latexForge",
          "title": "LaTeX Forge",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "latexForge": [
        {
          "id": "latexForgeProject",
          "name": "LaTeX Forge"
        },
        {
          "id": "latexForgeTemplates",
          "name": "Templates",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "latex-forge.diagnose",
          "when": "view == latexForgeProject",
          "group": "navigation@1"
        },
        {
          "command": "latex-forge.browseGallery",
          "when": "view == latexForgeTemplates",
          "group": "navigation@1"
        },
        {
          "command": "latex-forge.updateTemplates",
          "when": "view == latexForgeTemplates",
          "group": "navigation@2"
        },
        {
          "command": "latex-forge.installTemplate",
          "when": "view == latexForgeTemplates",
          "group": "navigation@3"
        },
        {
          "command": "latex-forge.refreshTemplates",
          "when": "view == latexForgeTemplates",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "latex-forge.removeTemplate",
          "when": "view == latexForgeTemplates && viewItem == latexForgeUserTemplate",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "compile": "node esbuild.mjs",
    "compile-tests": "tsc -p ./",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run compile-tests && npm run lint",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "glob": "^13.0.6",
    "mocha": "^10.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
